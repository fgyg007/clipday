<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>ClipDay.Cloud</AssemblyName><Version>0.2.0-preview.1</Version><InformationalVersion>0.2.0-preview.1</InformationalVersion>
    <ApplicationIcon>Assets/ClipDay.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets/ClipDay.ico" />
    <None Include="../../licenses/BouncyCastle.md" Link="BouncyCastle-LICENSE.md" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../ClipDay.Sync/ClipDay.Sync.csproj" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
</Project>
